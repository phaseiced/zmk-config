#include <dt-bindings/led/led.h>

/*
 * Keyball44 RGB DI (DATA) is Pro Micro D0 / RX on the published KiCad netlist.
 * On nice!nano v2 that is P0.08. Using spi3 keeps the trackball's spi1 free.
 *
 * If LEDs stay dark after flashing, try MOSI on P0.20 (Pro Micro D3 / QMK
 * WS2812_DI_PIN) instead — but that shares the OLED I2C SCL pin.
 */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;

        /* 30 per half; official Keyball44 is 30+29 physical LEDs */
        chain-length = <30>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};
